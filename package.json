{
  "name": "automedia-pro",
  "version": "1.0.0",
  "description": "Standalone Puppeteer automation for Google Labs ImageFX",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "start": "node index.js",
    "chrome": "node launch-chrome.js",
    "ui": "node server.js",
    "electron-start": "electron electron-main.js",
    "build:win": "electron-packager . \"AutoMedia Pro\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=public/icon.png --ignore=\"^/dist|^/prompts|^/browser-profiles\"",
    "build:portable-zip": "npm run build:win && powershell -Command \"Compress-Archive -Path 'dist/AutoMedia Pro-win32-x64' -DestinationPath 'dist/AutoMediaPro-Portable.zip' -Force\"",
    "build:portable-exe": "electron-builder --win",
    "build:all-portable": "npm run build:portable-zip && npm run build:portable-exe"
  },
  "build": {
    "appId": "com.automediapro.app",
    "productName": "AutoMedia Pro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}.exe"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!Start-UI.bat",
      "!prompts/**/*"
    ]
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "puppeteer-core": "^24.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "wait-on": "^9.0.10"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1"
  }
}